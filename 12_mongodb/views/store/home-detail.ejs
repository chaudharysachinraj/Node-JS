<%- include('../partials/head')%>
    </head>

    <body class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased">
        <%- include('../partials/nav')%>

            <main class="mx-auto max-w-6xl px-6 py-10 sm:py-14">
                <a href="/homes" class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-slate-600 transition hover:text-rose-600">
                    <span aria-hidden="true">←</span> Back to homes
                </a>

                <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
                    <div class="grid lg:grid-cols-2">
                        <div class="relative min-h-64 bg-slate-100 lg:min-h-112">
                            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="absolute inset-0 h-full w-full object-cover">
                            <div class="absolute left-5 top-5 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-amber-600 shadow-sm">
                                ★ <%= home.rating %> rating
                            </div>
                            <div class="absolute inset-x-5 bottom-5 flex gap-2 overflow-x-auto">
                                <% (home.photos || []).slice(0, 4).forEach(function(photo) { %>
                                    <img src="<%= photo %>" alt="<%= home.houseName %> photo" class="h-16 w-20 shrink-0 rounded-lg object-cover ring-2 ring-white/80">
                                <% }) %>
                            </div>
                        </div>

                        <div class="flex flex-col justify-center p-7 sm:p-10 lg:p-14">
                            <p class="text-sm font-semibold uppercase tracking-widest text-rose-500">Home details</p>
                            <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
                                <%= home.houseName %>
                            </h1>
                            <p class="mt-4 flex items-center gap-2 text-slate-600">
                                <span class="text-lg" aria-hidden="true">⌖</span>
                                <%= home.location %>
                            </p>

                            <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
                                <div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-500">Property type</p><p class="mt-1 font-semibold"><%= home.propertyType || 'Home' %></p></div>
                                <div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-500">Bedrooms</p><p class="mt-1 font-semibold"><%= home.bedrooms || 3 %></p></div>
                                <div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-500">Bathrooms</p><p class="mt-1 font-semibold"><%= home.bathrooms || 2 %></p></div>
                                <div class="rounded-xl bg-slate-50 p-3"><p class="text-xs text-slate-500">Guests</p><p class="mt-1 font-semibold"><%= home.guests || 6 %></p></div>
                            </div>

                            <div class="mt-6 rounded-2xl bg-slate-50 p-5">
                                <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-500">About this home</h2>
                                <p class="mt-3 leading-7 text-slate-600"><%= home.description || 'Enjoy a comfortable stay in this beautiful home.' %></p>
                            </div>

                            <div class="my-8 border-t border-slate-200"></div>

                            <div>
                                <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-500">Facilities</h2>
                                <div class="mt-4 grid grid-cols-2 gap-3 text-sm text-slate-600">
                                    <% (home.amenities || ['Wi-Fi', 'Air conditioning', 'Kitchen', 'Free parking', 'Swimming pool', 'TV']).forEach(function(amenity) { %>
                                        <span class="flex items-center gap-2"><span class="text-emerald-500">✓</span><%= amenity %></span>
                                    <% }) %>
                                </div>
                            </div>

                            <div class="my-8 border-t border-slate-200"></div>

                            <div class="flex items-end justify-between gap-4">
                                <div>
                                    <p class="text-sm text-slate-500">Price per night</p>
                                    <p class="mt-1 text-3xl font-bold text-slate-900">₹<%= home.price %></p>
                                </div>
                                <span class="rounded-full bg-amber-50 px-3 py-1.5 text-sm font-medium text-amber-700">
                                    ★ <%= home.rating %>
                                </span>
                            </div>

                            <form action="/bookings" method="POST" class="mt-8 space-y-4">
                                <div class="grid gap-3 sm:grid-cols-2">
                                    <label class="text-sm font-medium text-slate-600">Check-in<input type="date" name="checkIn" required class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2.5 text-slate-900 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500"></label>
                                    <label class="text-sm font-medium text-slate-600">Check-out<input type="date" name="checkOut" required class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2.5 text-slate-900 focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500"></label>
                                </div>
                                <input type="hidden" name="homeId" value="<%= home.id %>">
                                <button type="submit" class="w-full rounded-xl bg-rose-600 px-5 py-3.5 font-semibold text-white shadow-sm transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2">
                                    Book now
                                </button>
                            </form>

                            <%- include('../partials/add-to-favourite', { home: home }) %>
                        </div>
                    </div>
                </div>

                <div class="mt-8 grid gap-6 lg:grid-cols-3">
                    <section class="rounded-2xl border border-slate-200 bg-white p-6 lg:col-span-2">
                        <h2 class="text-xl font-bold">Property address</h2>
                        <p class="mt-3 text-slate-600"><%= home.address || home.location %></p>
                        <div class="mt-5 flex h-32 items-center justify-center rounded-xl bg-slate-100 text-sm text-slate-500">Property location map</div>
                    </section>
                    <section class="rounded-2xl border border-slate-200 bg-white p-6">
                        <h2 class="text-xl font-bold">House rules</h2>
                        <ul class="mt-4 space-y-3 text-sm text-slate-600">
                            <li>Check-in: <%= home.checkInTime || 'After 2:00 PM' %></li>
                            <li>Cancellation: <%= home.cancellationPolicy || 'Free cancellation' %></li>
                            <li>Pets: <%= home.petPolicy || 'Not allowed' %></li>
                        </ul>
                    </section>
                </div>
            </main>

    </body>

    </html>