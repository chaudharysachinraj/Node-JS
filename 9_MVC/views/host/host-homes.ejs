<%- include('../partials/head')%>
</head>
<body class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased">
    <%- include('../partials/nav')%>

    <main class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
            <h1 class="mb-8 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">All Host Homes</h1>
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <% homes.forEach(home => { %>
                <li class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-rose-200 hover:shadow-md">
                    <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="h-48 w-full object-cover">
                    <div class="p-4">
                        <div class="flex items-start justify-between gap-3">
                            <h2 class="text-xl font-semibold text-slate-900"><%= home.houseName %></h2>
                            <span class="whitespace-nowrap text-sm font-medium text-amber-600">★ <%= home.rating %></span>
                        </div>
                        <p class="mt-2 text-slate-600"><%= home.location %></p>
                        <div class="mt-4 flex items-center justify-between gap-3">
                            <p class="text-lg font-bold text-slate-900">₹<%= home.price %> <span class="text-sm font-normal text-slate-500">/ night</span></p>

                            <a href="/host/edit-home/<%= home.id %>?editing=true" class="rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2">Edit</a>

                            <form action="/host/delete-home/<%= home.id %>" method="post">
                                <button
                                class="rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2">Delete</button>
                            </form>
                        </div>
                       
                    </div>
                </li>
            <% }); %>
            </ul>
        </section>
    </main>

</body>
</html>