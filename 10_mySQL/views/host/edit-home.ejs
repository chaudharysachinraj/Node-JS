<%- include('../partials/head')%>
    </head>

    <body class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased">
        <%- include('../partials/nav')%>

            <main class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
                <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
                    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl"><%= editing ? "Edit" : "Add" %> your home</h1>
                    <p class="mt-3 text-base leading-7 text-slate-600">Share your place with guests looking for
                        somewhere to stay.</p>
                    <form class="mt-8 space-y-5" action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST"> 
                        <div class="flex flex-col gap-3"> 
                            <input type="hidden" name="id" value="<%= editing ? home.id : '' %>">
                            <input
                                class="w-full rounded-xl border border-slate-300  px-4 py-3 text-slate-900 shadow-sm"
                                id="houseName" type="text" name="houseName" 
                                value="<%= editing ? home.houseName : '' %>"
                                placeholder="Enter your home's name">
                            <div class="flex items-center gap-3">
                                <input
                                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 shadow-sm"
                                    type="text" name="price"
                                    value="<%= editing ? home.price : '' %>"
                                    placeholder="Enter your home's price">
                            </div>
                            <input
                                class="w-full rounded-xl border border-slate-300  px-4 py-3 text-slate-900 shadow-sm"
                                 type="text" 
                                 value="<%= editing ? home.location : '' %>"
                                 name="location" placeholder="Enter your home's location"
                                >
                            <input
                                class="w-full rounded-xl border border-slate-300  px-4 py-3 text-slate-900 shadow-sm"
                                type="text" 
                                value="<%= editing ? home.rating : '' %>"
                                name="rating" placeholder="Enter your home's rating"
                                >
                            <input
                                class="w-full rounded-xl border border-slate-300  px-4 py-3 text-slate-900 shadow-sm"
                                type="text" 
                                value="<%= editing ? home.photoUrl : '' %>"
                                name="photoUrl" placeholder="Enter your home's photo URL"
                                >
                        </div>
                        <button
                            class="inline-flex w-full items-center justify-center rounded-xl bg-rose-600 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2 sm:w-auto"
                            type="submit"><%= editing ? "Update" : "Add" %> Home</button>
                    </form>
                </section>
            </main>
    </body>

    </html>