<form action="/favourites" method="POST" class="mt-3">
    <input type="hidden" name="homeId" value="<%= home.id %>">
    <button type="submit"
        class="flex w-full items-center justify-center gap-2 rounded-xl border border-rose-200 px-5 py-3.5 font-semibold text-rose-600 transition hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2">
        <span aria-hidden="true">♡</span> Add to favourite
    </button>
</form>